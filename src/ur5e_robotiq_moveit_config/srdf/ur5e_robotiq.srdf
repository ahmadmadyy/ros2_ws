<?xml version="1.0"?>
<robot name="ur">

  <!-- Virtual joint: world -> base_link -->
  <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="base_link"/>

  <!-- Arm planning group -->
  <group name="ur_manipulator">
    <chain base_link="base_link" tip_link="tool0"/>
  </group>

  <!-- Gripper planning group -->
  <group name="gripper">
    <joint name="rq_robotiq_85_left_knuckle_joint"/>
    <joint name="rq_robotiq_85_right_knuckle_joint"/>
  </group>

  <end_effector name="robotiq_2f85" parent_link="tool0" group="gripper"/>

</robot>
