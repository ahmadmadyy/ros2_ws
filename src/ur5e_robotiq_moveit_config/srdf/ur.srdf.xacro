<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur">

  <!-- robot name parameter -->
  <xacro:arg name="name" default="ur5e"/>

  <xacro:include filename="$(find ur_moveit_config)/srdf/ur_macro.srdf.xacro"/>

  <xacro:ur_srdf/>
    <!-- Robotiq: allow self-collisions for adjacent/mimic links -->
  <disable_collisions link1="rq_robotiq_85_base_link" link2="rq_robotiq_85_left_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="rq_robotiq_85_base_link" link2="rq_robotiq_85_left_inner_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="rq_robotiq_85_base_link" link2="rq_robotiq_85_right_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="rq_robotiq_85_base_link" link2="rq_robotiq_85_right_inner_knuckle_link" reason="Adjacent"/>

  <disable_collisions link1="rq_robotiq_85_left_finger_link" link2="rq_robotiq_85_left_finger_tip_link" reason="Adjacent"/>
  <disable_collisions link1="rq_robotiq_85_right_finger_link" link2="rq_robotiq_85_right_finger_tip_link" reason="Adjacent"/>

  <disable_collisions link1="rq_robotiq_85_left_finger_link" link2="rq_robotiq_85_left_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="rq_robotiq_85_left_finger_tip_link" link2="rq_robotiq_85_left_inner_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="rq_robotiq_85_right_finger_link" link2="rq_robotiq_85_right_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="rq_robotiq_85_right_finger_tip_link" link2="rq_robotiq_85_right_inner_knuckle_link" reason="Adjacent"/>

  <!-- If your mounting causes contact at zero, allow it -->
  <disable_collisions link1="rq_robotiq_85_base_link" link2="wrist_3_link" reason="NeverCollide"/>


</robot>
