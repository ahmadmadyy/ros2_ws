  <version>0.0.0</version>
  <description>MoveIt API demos for UR + Robotiq</description>

  <maintainer email="madyahmad19@gmail.com">ubuntu</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

