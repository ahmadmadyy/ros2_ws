<?xml version="1.0"?>
<package format="3">
  <name>ur5e_robotiq_moveit_config</name>
  <version>0.0.1</version>
  <description>MoveIt config for UR5e + Robotiq 2F-85</description>
  <maintainer email="madyahmad19@gmail.com">Ahmed Mady</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>moveit_ros_planning_interface</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>

  <exec_depend>ur_description</exec_depend>
  <exec_depend>robotiq_description</exec_depend>
  <exec_depend>ur_yt_sim</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

